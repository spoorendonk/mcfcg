build*/
.cache/
__pycache__/
data/intermodal-repo/
data/intermodal/raw/

# Local agent/dev tooling — not part of the published artifact.
.devkit/
.claude/
.codex/

# Derived MPS dumps (regenerable via scripts/write_mps.sh) — large, not committed.
*.mps.gz
*.mps
# Benchmark outputs (scripts/benchmark_solvers.py).
# Per-run CG logs are bulky and regenerable — never tracked. One exception:
# results/ablation/logs/ (the gh#41 pricing-cutoff A/B) IS committed, because it
# settles a design question rather than feeding a results table and is not meant
# to be re-run. See results/ablation/README.md and PROVENANCE.txt section 5.1.
bench-logs/
bench_runs/
bench-*.log
Highs.log
# Intermediate/ad-hoc result CSVs stay local (scripts default under bench_runs/);
# the canonical full-suite "one truth" results are committed under results/.
bench-*.csv
