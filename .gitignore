build*/
.cache/
__pycache__/
data/intermodal-repo/
data/intermodal/raw/

# Local agent/dev tooling — not part of the published artifact.
.claude/
.codex/

# Derived MPS dumps (regenerable via scripts/write_mps.sh) — large, not committed.
*.mps.gz
*.mps
# Benchmark outputs (scripts/benchmark_solvers.py).
# Per-run CG logs are bulky and regenerable — never tracked. The gh#41
# bounded-pricing A/B is the exception: it settles a design question rather than
# feeding a results table, so its logs ARE the artifact. They are tracked under
# results/ablation/<round>/logs/, which no rule here ignores; a sweep's raw
# output still lands under bench_runs/ and is copied across sanitised. See
# results/ablation/README.md.
bench-logs/
bench_runs/
bench-*.log
Highs.log
# Intermediate/ad-hoc result CSVs stay local (scripts default under bench_runs/);
# the canonical full-suite "one truth" results are committed under results/.
bench-*.csv
